generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String
  name      String?
  image     String?
  posts     Post[]
  sessions  Session[]
  createdAt DateTime  @default(now())
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id])
  media     Media[] 
  authorId  Int
  createdAt DateTime @default(now())
}

model Media {
  id        Int       @id @default(autoincrement())
  type      MediaType
  url       String
  post      Post      @relation(fields: [postId], references: [id])
  postId    Int 
}

enum MediaType {
  IMAGE
  VIDEO
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}
